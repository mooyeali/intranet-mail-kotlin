[Unit]
Description=Intranet Mail Kotlin Service
After=network.target

[Service]
Type=simple
User=mailapp
Group=mailapp
WorkingDirectory=/opt/intranet-mail
Environment=MAIL_DOMAIN=corp.local
Environment=HTTP_PORT=8080
Environment=SMTP_PORT=25
Environment=H2_URL=jdbc:h2:/opt/intranet-mail/data/intranet-mail;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE
Environment=ATTACHMENT_DIR=/opt/intranet-mail/data/attachments
Environment=ADMIN_USER=admin
Environment=ADMIN_TOKEN=replace-with-long-random-token
Environment=ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
ExecStart=/usr/bin/java -jar /opt/intranet-mail/app.jar
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/intranet-mail/data

[Install]
WantedBy=multi-user.target
