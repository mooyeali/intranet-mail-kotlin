[Unit]
Description=Intranet Mail Kotlin Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mailapp
Group=mailapp
WorkingDirectory=/opt/intranet-mail
Environment=MAIL_DOMAIN=corp.local
Environment=HTTP_PORT=8080
Environment=SMTP_PORT=25
Environment=POP3_PORT=1110
Environment=H2_URL=jdbc:h2:/opt/intranet-mail/data/intranet-mail;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE
Environment=ATTACHMENT_DIR=/opt/intranet-mail/data/attachments
Environment=ADMIN_USER=admin
# Put real values in /etc/intranet-mail/intranet-mail.env with mode 0600.
EnvironmentFile=-/etc/intranet-mail/intranet-mail.env
ExecStartPre=/usr/bin/test -d /opt/intranet-mail/data
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=75 -jar /opt/intranet-mail/app.jar
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
LimitNOFILE=65536
MemoryMax=768M
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/intranet-mail/data
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
